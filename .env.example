# Copy to .env and change every value marked CHANGE. Never commit .env.
POSTGRES_PASSWORD=CHANGE-to-a-long-random-password

# Sign-in (recommended for anything beyond your own laptop)
SCOUTIQ_AUTH_MODE=on
SCOUTIQ_AUTH_SECRET=CHANGE-to-48-random-characters      # python -c "import secrets;print(secrets.token_urlsafe(48))"
SCOUTIQ_BOOTSTRAP_ADMIN_USER=admin
SCOUTIQ_BOOTSTRAP_ADMIN_PASSWORD=CHANGE-then-remove-after-first-sign-in

# Browser access: the address people use to open the web app
SCOUTIQ_CORS_ORIGINS=https://scout.example.com
SCOUTIQ_ENABLE_DOCS=false
SCOUTIQ_HSTS=on                                          # only when served over HTTPS
SCOUTIQ_TRUST_PROXY=off                                  # on only behind your own reverse proxy

# Optional shared API key for machine clients (browsers use sign-in instead)
# SCOUTIQ_API_KEY=
LOG_LEVEL=INFO
